# Environment Variables for Aditya Chatbot & Student Support System

# Local MongoDB Connection (Default fallback):
# MONGO_URI=mongodb://127.0.0.1:27017/aditya_chatbot

# MongoDB Atlas Cloud Connection (Replace with your Atlas connection URI):
MONGO_URI=mongodb+srv://admin:yourpassword@cluster0.xxxxx.mongodb.net/aditya_chatbot?retryWrites=true&w=majority

# Server Port:
PORT=3000
